" Generated by hx-highlight.
highlight default HxHighlight_todo ctermfg=white ctermbg=red guifg=#ffffff guibg=#cc241d
highlight default HxHighlight_bead ctermfg=white ctermbg=red guifg=#ffffff guibg=#cc241d
highlight default HxHighlight_note ctermfg=white ctermbg=red guifg=#ffffff guibg=#cc241d
highlight default HxHighlight_done ctermfg=white ctermbg=green guifg=#ffffff guibg=#98971a

function! HxHighlightApply() abort
  for id in get(b:, 'hx_highlight_matches', [])
    silent! call matchdelete(id)
  endfor
  let b:hx_highlight_matches = []
  call add(b:hx_highlight_matches, matchadd('HxHighlight_todo', "\\<TODO\\>"))
  call add(b:hx_highlight_matches, matchadd('HxHighlight_bead', "\\<BEAD\\>"))
  call add(b:hx_highlight_matches, matchadd('HxHighlight_note', "\\<NOTE\\>"))
  call add(b:hx_highlight_matches, matchadd('HxHighlight_done', "\\<DONE\\>"))
endfunction

augroup HxHighlight
  autocmd!
  autocmd BufWinEnter,FileType * call HxHighlightApply()
augroup END

call HxHighlightApply()
